{
  "name": "ChatbotMemory",
  "type": "object",
  "properties": {
    "chatbot_name": {
      "type": "string",
      "description": "Name of the chatbot this memory belongs to"
    },
    "content": {
      "type": "string",
      "description": "Memory content"
    },
    "category": {
      "type": "string",
      "description": "Category of the memory"
    },
    "importance": {
      "type": "integer",
      "default": 5,
      "description": "Importance score of the memory"
    }
  },
  "required": [
    "chatbot_name",
    "content"
  ]
}