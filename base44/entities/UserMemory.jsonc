{
  "name": "UserMemory",
  "type": "object",
  "properties": {
    "communication_style": {
      "type": "string",
      "description": "How the user prefers to communicate"
    },
    "emotional_patterns": {
      "type": "string",
      "description": "Observed emotional patterns and triggers"
    },
    "spiritual_maturity": {
      "type": "string",
      "description": "Assessment of the user's spiritual maturity and growth"
    },
    "fitness_observations": {
      "type": "string",
      "description": "Observations about the user's fitness habits and progress"
    },
    "nutrition_observations": {
      "type": "string",
      "description": "Observations about the user's nutrition habits and preferences"
    },
    "life_events": {
      "type": "string",
      "description": "Significant life events mentioned by the user"
    },
    "goals_mentioned": {
      "type": "string",
      "description": "Goals the user has expressed across conversations"
    },
    "struggles_mentioned": {
      "type": "string",
      "description": "Struggles and challenges the user has shared"
    },
    "wins_celebrated": {
      "type": "string",
      "description": "Wins and achievements celebrated with the user"
    },
    "favorite_topics": {
      "type": "string",
      "description": "Topics the user engages with most frequently or enthusiastically"
    },
    "conversation_preferences": {
      "type": "string",
      "description": "Preferred conversation styles, depth, and formats"
    },
    "raw_insights": {
      "type": "string",
      "description": "Raw AI-generated insights about the user"
    },
    "last_updated": {
      "type": "string",
      "description": "Timestamp of the last memory update"
    },
    "interaction_count": {
      "type": "integer",
      "default": 0,
      "description": "Total number of interactions with the user"
    }
  },
  "required": []
}