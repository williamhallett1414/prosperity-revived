{
  "name": "JournalEntry",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Entry title"
    },
    "content": {
      "type": "string",
      "description": "Journal entry content"
    },
    "entry_type": {
      "type": "string",
      "enum": [
        "gratitude",
        "prayer",
        "reflection",
        "scripture_reflection",
        "mood_tracker",
        "general",
        "bible_notes",
        "emotional_checkin",
        "affirmation",
        "weekly_reflection",
        "habit_tracker",
        "mindset_reset",
        "video_journal"
      ],
      "default": "general",
      "description": "Type of journal entry"
    },
    "mood": {
      "type": "string",
      "enum": [
        "joyful",
        "grateful",
        "struggling",
        "hopeful",
        "peaceful",
        "seeking",
        "Low",
        "Okay",
        "Good",
        "Great"
      ],
      "description": "Mood at time of entry"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Custom tags for categorization and retrieval"
    },
    "sentiment": {
      "type": "string",
      "enum": [
        "very_negative",
        "negative",
        "neutral",
        "positive",
        "very_positive"
      ],
      "description": "AI-analyzed sentiment of the entry"
    },
    "sentiment_score": {
      "type": "number",
      "description": "Numerical sentiment score (-1 to 1)"
    },
    "emotions_detected": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of emotions detected in the entry"
    },
    "key_themes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Main themes or topics from the entry"
    },
    "video_url": {
      "type": "string",
      "description": "URL of video for video journal entries"
    },
    "video_duration": {
      "type": "number",
      "description": "Duration of video in seconds"
    },
    "prompt": {
      "type": "string",
      "description": "Journal prompt that was used"
    },
    "suggested_practice": {
      "type": "string",
      "description": "AI-suggested practice or action"
    },
    "habits": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Associated habit trackers"
    }
  },
  "required": [
    "content"
  ]
}